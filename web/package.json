{
  "name": "cronicas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend React+Vite do RPG (Fase 1). Fala com a API FastAPI.",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "build": "tsc -b && vite build && node scripts/legal.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "lint": "eslint src e2e tests",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "motion": "^12.42.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
