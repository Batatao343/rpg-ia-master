# =====================================================================
# ROTEAMENTO DE LLM
# =====================================================================
# Modo de produto (spec roteamento-multi-provider): rotas por tier com
# fallback. Deixe LLM_PROVIDER VAZIO para usar a tabela ROUTES (multi-provider);
# preencha só as keys dos providers que a sua stack usa.
#
# Override legado: LLM_PROVIDER=gemini|ollama|openai|openai_compat força TODOS
# os tiers a um único provider (ignora ROUTES). Útil p/ jogo 100% local (ollama).
LLM_PROVIDER=

# Override de rotas por arquivo (opcional): caminho de um JSON no formato
# {"classify": [["groq","..."],...], "fast": [...], "smart": [...]}
# RPG_ROUTES=

# --- Gemini (Google AI) --- tier CLASSIFY (fallback) ---
# Gerar em: https://aistudio.google.com/app/apikey
# Sem NENHUMA key configurada, o jogo roda em modo simulado (MockLLM).
GOOGLE_API_KEY=

# --- Groq (LPU — inferência rápida de modelos open) --- CLASSIFY + FAST/SMART fallback ---
# Gerar em: https://console.groq.com/keys
GROQ_API_KEY=

# --- Qwen (Alibaba / DashScope, endpoint Internacional) --- tier FAST ---
# Gerar em: https://bailian.console.alibabacloud.com (chave DashScope)
# ATENÇÃO: o ROUTES usa o endpoint INTERNACIONAL (Singapura). Key de região CN
# (Pequim) dá 401 aqui — gere a key na console Internacional (ou ajuste o base_url
# em llm_setup.PROVIDER_ENDPOINTS["qwen"]).
QWEN_API_KEY=

# --- MiniMax (roleplay/criativo) --- tier FAST (preferido) ---
# Gerar em: https://www.minimax.io/platform
MINIMAX_API_KEY=

# --- DeepSeek --- tier SMART (preferido; raciocínio barato) ---
# Gerar em: https://platform.deepseek.com (exige saldo — API é pré-paga)
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=12

# --- Anthropic Claude --- tier SMART (fallback; teto de coerência) ---
# Requer: uv sync --extra anthropic. Gerar em: https://console.anthropic.com
# NB: Claude 5 não aceita `temperature` nem prefill (prompt terminando em assistant).
ANTHROPIC_API_KEY=

# --- Jev / TypeSafe oficial (SPEC-177; server-side, opt-in) ---
# TYPESAFE_API_KEY é canônica. JEVMODEL_API_KEY permanece alias compatível.
TYPESAFE_API_KEY=
JEVMODEL_API_KEY=

# SPEC-180: Jev é backend de decisão, não provider de chat/LLM.
# Resultado A/B atual = NO_GO; o padrão seguro é off (zero chamadas Jev por turno).
# shadow é opt-in e apenas observa; cada turno elegível pode custar uma chamada.
RPG_JEV_ROUTER_MODE=off
# primary exige decisão de promoção explícita e limiar congelado em código
# por tarefa de eval-authoring separada. Hoje PRIMARY_CALIBRATION=None: fail-closed.
# RPG_JEV_ROUTER_PRIMARY_APPROVED=1

# --- GLM / Zhipu --- opcional (fora do ROUTES default; site em mandarim) ---
# GLM_API_KEY=

# --- Kimi / Moonshot --- opcional (Groq não expõe kimi-k2 por padrão) ---
# KIMI_API_KEY=

# --- Ollama (LLM local via Ollama) --- só com LLM_PROVIDER=ollama ---
# Requer: uv sync --extra ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_CLASSIFY=qwen3:4b  # tier CLASSIFY (parse/router)
# OLLAMA_MODEL_FAST=llama3.2      # ou qwen2.5, mistral, etc.
# OLLAMA_MODEL_SMART=llama3.1     # ou qwen2.5:72b

# --- OpenAI --- só com LLM_PROVIDER=openai ---
# Requer: uv sync --extra openai
# OPENAI_API_KEY=
# OPENAI_MODEL_CLASSIFY=gpt-5.4-nano
# OPENAI_MODEL_FAST=gpt-5.4-mini
# OPENAI_MODEL_SMART=gpt-5.4

# --- OpenAI-compatível (Qwen via Dashscope, LM Studio, etc.) ---
# LLM_PROVIDER=openai_compat
# OPENAI_API_KEY=<sua chave>
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL_FAST=qwen-plus
# OPENAI_MODEL_SMART=qwen-max

# =====================================================================
# EMBEDDINGS (RAG — lore/regras/memória de sessão)   spec embeddings-provider
# =====================================================================
# Cadeia ordenada (rag.EMBEDDING_ROUTES): jina → openai → ollama → gemini.
# Resolve o PRIMEIRO com key/dep disponível. Gemini é o ÚLTIMO fallback
# (caro/sem créditos) — só assume sem nenhum outro. Cada índice FAISS fica
# PINADO ao provider que o gerou (embeddings_meta.json); trocar de provider
# exige re-indexar: `uv run python rag.py`.
#
# --- Jina v3 (PRIMÁRIO recomendado) --- $0.02/M + 10M tokens grátis por key ---
# Gerar em: https://jina.ai/embeddings (PT-BR forte; 1024 dims)
JINA_API_KEY=
#
# OpenAI text-embedding-3-small: usa OPENAI_API_KEY (seção LLM acima) + extra openai.
# Ollama bge-m3 (local, $0): uv sync --extra ollama (sem key).
#
# Override: força um provider específico (pula a cadeia; análogo a LLM_PROVIDER):
# RPG_EMBEDDINGS=jina|openai|ollama|gemini

# --- Fase 10: hardening ---
# CORS da API (CSV). Default: localhost:8000 e :5173. "*" só se souber o risco.
# RPG_CORS_ORIGINS=http://localhost:8000,http://localhost:5173
# Rate limit de /game/action, /game/new, /game/equip e /game/levelup (req/min por IP). 0 desliga.
# RPG_RATE_LIMIT=30
# Bind do `python api.py`. Default 127.0.0.1 (API sem auth até a Fase 10b);
# 0.0.0.0 expõe na LAN — use conscientemente.
# RPG_HOST=127.0.0.1
# --- Fase 10b: perfis de infraestrutura (default seguro = legacy local) ---
RPG_RUNTIME_PROFILE=legacy
RPG_GAME_STORE=file
RPG_MEMORY_STORE=faiss
RPG_RUNTIME_CATALOG=file
RPG_BLOB_STORE=file
RPG_JOB_QUEUE=inline
RPG_RATE_LIMIT_STORE=memory
RPG_AUTH_MODE=disabled
RPG_BIND_HOST=127.0.0.1
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend/worker somente; nunca prefixar com VITE_ nem enviar ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Latência do turno (default conservador após gate real R29) ---
# O fan-out/fan-in de plano+rota permanece disponível para experimentos.
# O gate real R29 piorou a cauda do DeepSeek; concurrent segue opt-in experimental.
RPG_TURN_EXECUTION=sequential
# Leituras independentes de lore/sessão/NPC; 1 mantém execução serial.
RPG_CONTEXT_MAX_CONCURRENCY=3
# Tetos globais entre campanhas/process requests (por processo).
RPG_CONTEXT_GLOBAL_CONCURRENCY=12
RPG_EMBEDDING_MAX_CONCURRENCY=2
# Backpressure por provider. Override: RPG_LLM_MAX_CONCURRENCY_DEEPSEEK=1
RPG_LLM_MAX_CONCURRENCY=2
