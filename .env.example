# =====================================================================
# ROTEAMENTO DE LLM
# =====================================================================
# Modo de produto (spec roteamento-multi-provider): rotas por tier com
# fallback. Deixe LLM_PROVIDER VAZIO para usar a tabela ROUTES (multi-provider);
# preencha só as keys dos providers que a sua stack usa.
#
# Override legado: LLM_PROVIDER=gemini|ollama|openai|openai_compat força TODOS
# os tiers a um único provider (ignora ROUTES). Útil p/ jogo 100% local (ollama).
LLM_PROVIDER=

# Override de rotas por arquivo (opcional): caminho de um JSON no formato
# {"classify": [["groq","..."],...], "fast": [...], "smart": [...]}
# RPG_ROUTES=

# --- Gemini (Google AI) --- tier CLASSIFY (fallback) ---
# Gerar em: https://aistudio.google.com/app/apikey
# Sem NENHUMA key configurada, o jogo roda em modo simulado (MockLLM).
GOOGLE_API_KEY=

# --- Groq (LPU — inferência rápida de modelos open) --- CLASSIFY + FAST/SMART fallback ---
# Gerar em: https://console.groq.com/keys
GROQ_API_KEY=

# --- Qwen (Alibaba / DashScope, endpoint Internacional) --- tier FAST ---
# Gerar em: https://bailian.console.alibabacloud.com (chave DashScope)
# ATENÇÃO: o ROUTES usa o endpoint INTERNACIONAL (Singapura). Key de região CN
# (Pequim) dá 401 aqui — gere a key na console Internacional (ou ajuste o base_url
# em llm_setup.PROVIDER_ENDPOINTS["qwen"]).
QWEN_API_KEY=

# --- MiniMax (roleplay/criativo) --- tier FAST (preferido) ---
# Gerar em: https://www.minimax.io/platform
MINIMAX_API_KEY=

# --- DeepSeek --- tier SMART (preferido; raciocínio barato) ---
# Gerar em: https://platform.deepseek.com (exige saldo — API é pré-paga)
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_SECONDS=12

# --- Anthropic Claude --- tier SMART (fallback; teto de coerência) ---
# Requer: uv sync --extra anthropic. Gerar em: https://console.anthropic.com
# NB: Claude 5 não aceita `temperature` nem prefill (prompt terminando em assistant).
ANTHROPIC_API_KEY=

# --- Jev / TypeSafe oficial (SPEC-177; server-side, opt-in) ---
# TYPESAFE_API_KEY é canônica. JEVMODEL_API_KEY permanece alias compatível.
TYPESAFE_API_KEY=
JEVMODEL_API_KEY=

# SPEC-180: Jev é backend de decisão, não provider de chat/LLM.
# Resultado A/B atual = NO_GO; o padrão seguro é off (zero chamadas Jev por turno).
# shadow é opt-in e apenas observa; cada turno elegível pode custar uma chamada.
RPG_JEV_ROUTER_MODE=off
# primary exige decisão de promoção explícita e limiar congelado em código
# por tarefa de eval-authoring separada. Hoje PRIMARY_CALIBRATION=None: fail-closed.
# RPG_JEV_ROUTER_PRIMARY_APPROVED=1

# --- GLM / Zhipu --- opcional (fora do ROUTES default; site em mandarim) ---
# GLM_API_KEY=

# --- Kimi / Moonshot --- opcional (Groq não expõe kimi-k2 por padrão) ---
# KIMI_API_KEY=

# --- Ollama (LLM local via Ollama) --- só com LLM_PROVIDER=ollama ---
# Requer: uv sync --extra ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_CLASSIFY=qwen3:4b  # tier CLASSIFY (parse/router)
# OLLAMA_MODEL_FAST=llama3.2      # ou qwen2.5, mistral, etc.
# OLLAMA_MODEL_SMART=llama3.1     # ou qwen2.5:72b

# --- OpenAI --- só com LLM_PROVIDER=openai ---
# Requer: uv sync (langchain-openai e core)
# OPENAI_API_KEY=
# OPENAI_MODEL_CLASSIFY=gpt-5.4-nano
# OPENAI_MODEL_FAST=gpt-5.4-mini
# OPENAI_MODEL_SMART=gpt-5.4

# --- OpenAI-compatível (Qwen via Dashscope, LM Studio, etc.) ---
# LLM_PROVIDER=openai_compat
# OPENAI_API_KEY=<sua chave>
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL_FAST=qwen-plus
# OPENAI_MODEL_SMART=qwen-max

# =====================================================================
# EMBEDDINGS (RAG — lore/regras/memória de sessão)   spec embeddings-provider
# =====================================================================
# Cadeia ordenada (rag.EMBEDDING_ROUTES): jina → openai → ollama → gemini.
# Resolve o PRIMEIRO com key/dep disponível. Gemini é o ÚLTIMO fallback
# (caro/sem créditos) — só assume sem nenhum outro. Cada índice FAISS fica
# PINADO ao provider que o gerou (embeddings_meta.json); trocar de provider
# exige re-indexar: `uv run python rag.py`.
#
# --- Jina v3 (PRIMÁRIO recomendado) --- US$ 0.05/M (Standard, desde 2025-05) + 10M tokens grátis por key ---
# Gerar em: https://jina.ai/embeddings (PT-BR forte; 1024 dims)
JINA_API_KEY=
#
# OpenAI text-embedding-3-small: usa OPENAI_API_KEY (seção LLM acima) (langchain-openai e core).
# Ollama bge-m3 (local, $0): uv sync --extra ollama (sem key).
#
# Override: força um provider específico (pula a cadeia; análogo a LLM_PROVIDER):
# RPG_EMBEDDINGS=jina|openai|ollama|gemini

# --- Fase 10: hardening ---
# CORS da API (CSV). Default: localhost:8000 e :5173. "*" só se souber o risco.
# RPG_CORS_ORIGINS=http://localhost:8000,http://localhost:5173
# Rate limit de /game/action, /game/new, /game/equip e /game/levelup (req/min por IP). 0 desliga.
# RPG_RATE_LIMIT=30
# SPEC-219: classes de rota (turn, llm_aux, embedding, quote, mutation, payments, export, stt,
# read_auth). Defaults IP/owner por minuto: turn 60/20, llm_aux 30/6, embedding 30/10, quote 30/10,
# mutation 60/30, payments 15/5, export 30/6, read_auth 300/120. Override por classe (0 desliga o escopo):
# RPG_LIMIT_<CLASSE>_IP=  /  RPG_LIMIT_<CLASSE>_OWNER=   (ex.: RPG_LIMIT_TURN_OWNER=30)
# RPG_RATE_LIMIT=N define o limite de IP de todas as classes (exceto read_auth); RPG_RATE_LIMIT=0 desliga
# TODOS os limites por minuto (suite/smoke local; perfis hosted exigem >= 1).
# Cota diaria de turnos+LLM por owner (dia UTC, perfis com banco). 0 desliga. Default 600.
# RPG_DAILY_TURN_QUOTA=600
# Ordens Stripe abertas (created/checkout_pending) por owner antes de recusar uma nova. Default 3.
# RPG_LIMIT_PAYMENTS_OPEN_ORDERS=3
# IP real atras de proxy: na Vercel (VERCEL=1) usa x-vercel-forwarded-for; em outro proxy confiavel
# informe quantos saltos ha a direita de X-Forwarded-For (0/ausente = usa o IP da conexao).
# RPG_TRUSTED_PROXY_HOPS=0
# Cache (s) do verificador de sessao: evita 1 chamada ao Auth por request. 0 desliga. Default 20.
# RPG_VERIFY_CACHE_SECONDS=20
# Teto de custo de TEXTO (opt-in): com RPG_DAILY_SPEND_CAP_BRL definido, 1 faz novos turnos
# responderem 503 daily_spend_cap quando o gasto do dia estoura (leitura leve, cache 30 s).
# RPG_DAILY_SPEND_CAP_TEXT=0
# SPEC-221: /metrics. Perfis DB (local/hosted/hosted-supabase) exigem
# `Authorization: Bearer <RPG_METRICS_TOKEN>` (>=32 chars); sem a env o endpoint responde 404
# (nao derruba o boot). legacy sem a env mantem scrape aberto em loopback.
# RPG_METRICS_TOKEN=
# TTL (s) do bloco SQL de /metrics por processo. Default 15.
# RPG_METRICS_SQL_CACHE_S=15
# Bind do `python api.py`. Default 127.0.0.1 (API sem auth até a Fase 10b);
# 0.0.0.0 expõe na LAN — use conscientemente.
# RPG_HOST=127.0.0.1
# --- Fase 10b: perfis de infraestrutura (default seguro = legacy local) ---
# hosted = OIDC + S3; hosted-supabase = Supabase Auth + Storage + Postgres
# transacional em Vercel/serverless. O profile local não é configuração cloud.
RPG_RUNTIME_PROFILE=legacy
RPG_GAME_STORE=file
RPG_MEMORY_STORE=faiss
RPG_RUNTIME_CATALOG=file
RPG_BLOB_STORE=file
RPG_JOB_QUEUE=inline
RPG_RATE_LIMIT_STORE=memory
RPG_AUTH_MODE=disabled
RPG_BIND_HOST=127.0.0.1
DATABASE_URL=
# Para hosted-supabase, copie o Transaction pooler do painel Supabase:
# postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:6543/postgres?sslmode=require
# SPEC-224 (RLS efetivo): em hosted* o DATABASE_URL deve ser o login de MENOR privilegio `rpg_runtime`
# (nunca postgres) e RPG_ADMIN_DATABASE_URL o login de sistema `rpg_admin` (workers/cron/wallet), com
# usuarios distintos. Cada request de usuario roda `SET LOCAL ROLE rpg_api` + owner (policies por owner).
# ROLLBACK documentado: RPG_REQUEST_RLS=off + DATABASE_URL=postgres (comportamento anterior). Local: opcional.
RPG_ADMIN_DATABASE_URL=
# RPG_REQUEST_RLS=on
# O pool da aplicação é por instância warm; default hosted-supabase 0..1.
# RPG_DB_POOL_MIN_SIZE=0
# RPG_DB_POOL_MAX_SIZE=1
# RPG_DB_POOL_TIMEOUT_SECONDS=5
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend/worker somente; aceita sb_secret_ ou JWT service_role legado. Nunca
# prefixar com VITE_ nem enviar ao browser. O backend verifica o usuário por JWT.
SUPABASE_SERVICE_ROLE_KEY=
# SPEC-190: auth pública. Configure confirmação de e-mail também no Supabase Auth;
# templates locais em supabase/templates e links hosted no painel Auth.
# Hosted deve habilitar CAPTCHA/Turnstile antes de abrir signup/reset ao público.
RPG_AUTH_EMAIL_CONFIRMATION_REQUIRED=1
RPG_AUTH_CAPTCHA_REQUIRED=0
# app = valida Turnstile no proxy (default); gotrue = encaminha token virgem
# para Supabase Auth nativo em signup/login/reset/resend/reauth. Hosted público
# deve configurar CAPTCHA nativo no painel GoTrue; SPEC-191 verifica staging.
RPG_AUTH_CAPTCHA_MODE=app
RPG_TURNSTILE_SITE_KEY=
RPG_TURNSTILE_SECRET=
# Diagnóstico read-only e redacted: uv run python -m scripts.cloud_doctor

# --- Latência do turno (default conservador após gate real R29) ---
# O fan-out/fan-in de plano+rota permanece disponível para experimentos.
# O gate real R29 piorou a cauda do DeepSeek; concurrent segue opt-in experimental.
RPG_TURN_EXECUTION=sequential
# Leituras independentes de lore/sessão/NPC; 1 mantém execução serial.
RPG_CONTEXT_MAX_CONCURRENCY=3
# Tetos globais entre campanhas/process requests (por processo).
RPG_CONTEXT_GLOBAL_CONCURRENCY=12
RPG_EMBEDDING_MAX_CONCURRENCY=2
# Backpressure por provider. Override: RPG_LLM_MAX_CONCURRENCY_DEEPSEEK=1
RPG_LLM_MAX_CONCURRENCY=2

# --- SPEC-186: transcrição privada, desativada até configuração explícita ---
# Endpoint /account/transcriptions: sessão+CSRF, raw audio body, x-operation-id UUID.
# Usa GROQ_API_KEY / OPENAI_API_KEY do backend. Não instala SDK de STT.
RPG_SPEECH_ENABLED=0
# Versão imutável publicada pelo operador; falta/stale/saldo insuficiente = zero chamada.
RPG_SPEECH_PRICING_VERSION=
RPG_SPEECH_MAX_RESERVE_MILLI=100

# --- SPEC-188: quotes de imagem, fechados sem configuração server-side ---
# Profiles de preço são fatos imutáveis publicados pelo operador no banco.
# Esta migration não publica preços, não credita saldo nem ativa o provider.
RPG_DYNAMIC_ART_ENABLED=0
RPG_IMAGE_PRICE_PROFILE=
# Overrides por formato, para cotar retratos/NPCs e cenas simultaneamente.
# RPG_IMAGE_PRICE_PROFILE_PORTRAIT=
# RPG_IMAGE_PRICE_PROFILE_SCENE=
RPG_SPEECH_GROQ_MODEL=whisper-large-v3-turbo
RPG_SPEECH_OPENAI_MODEL=gpt-4o-mini-transcribe
# WAV PCM usa stdlib; WebM/Ogg/MP4 exigem ffmpeg instalado no servidor.
# RPG_SPEECH_FFMPEG=/usr/bin/ffmpeg
# SPEC-189: explicitly enabled Stripe TEST mode only; default disabled.
# Publish an immutable server-side SKU/pricing version before allowlisting it.
# Never put these backend secrets in VITE_* or the browser bundle.
RPG_STRIPE_ENABLED=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RPG_STRIPE_ALLOWED_SKUS=[]
RPG_CHECKOUT_ORIGIN=

# --- SPEC-218: fail-closed de perfil (NUNCA em producao) ---
# Hospedagem (VERCEL/RAILWAY_ENVIRONMENT/RENDER/K_SERVICE/FLY_APP_NAME/DYNO/PORT, RPG_HOST/RPG_BIND_HOST fora de loopback) exige RPG_RUNTIME_PROFILE=hosted*.
# Dev local que seta PORT: defina RPG_BIND_HOST=127.0.0.1 (loopback explicito remove PORT dos marcadores).
# Overrides de laboratorio (listados em FORBIDDEN_IN_PROD do checklist de release):
# RPG_ALLOW_LEGACY_EXPOSED=1   # permite perfil legacy em processo exposto
# RPG_ALLOW_INSECURE_HOSTED=1  # pula HOSTED_SECURITY_REQUIREMENTS (health.hardened fica false)
# RPG_EXPOSE_OPENAPI=1         # publica /docs e /openapi.json em perfil hosted (so staging)
# hosted* tambem exige: RPG_COOKIE_SECURE=1, RPG_SESSION_SECRET>=32, RPG_TELEMETRY_SECRET>=32,
# RPG_CORS_ORIGINS https explicito, captcha obrigatorio, confirmacao de email e RPG_NO_MOCK=1 ou chave de provider.

# --- Botoes operacionais opcionais (SPEC-274; os defaults abaixo ja valem) ---
# RPG_CRON_MAX_RECONCILE=100        # lote do cron de reconciliacao de compras
# RPG_CRON_MAX_WALLET_RECOVERY=50   # lote do cron de recuperacao de wallet
# RPG_FINOPS_REPORT_DAYS=30         # janela do relatorio FinOps
# RPG_FINOPS_ALERT_HOURS=24         # janela dos alertas FinOps
# RPG_BACKUP_ROOT=readiness_artifacts  # raiz dos backups lida por rpg_backup_age_seconds
# RPG_PLAYTEST_STALE_SECONDS=21600  # idade para marcar manifesto de playtest como stale
# SPEC-239: nivel de log dos eventos rpg.* (debug|info|warning|error; default info).
# RPG_LOG_LEVEL=info
# RPG_LOG_LEVEL_<AREA>=warning   (override por area, ex.: RPG_LOG_LEVEL_LIBRARIAN)
# SPEC-244: beacon de erro do cliente (POST /telemetry/client-error). Ligado por default; 0 = kill switch.
# RPG_CLIENT_ERROR_REPORT=1

# SPEC-297: pool compartilhado entre mundos (NPCs/criaturas/itens/locais gerados). Default off.
# RPG_SHARED_POOL=off            # off | shadow (mede, sem expor) | on (expoe entre jogos)
# RPG_POOL_HOLD_HOURS=24        # quarentena antes da avaliacao
# RPG_POOL_SUBMIT_PER_OWNER_DAY=20
# RPG_POOL_DUP_THRESHOLD=0.90   # cosseno minimo p/ near_duplicate
# RPG_POOL_EVAL_PER_RUN=25
# RPG_POOL_EVAL_PER_DAY=200
# RPG_POOL_REUSE_RATE=0.5       # chance por turno de oferecer elenco ao narrador
# RPG_POOL_ALLOW_MOCK_EVAL=1   # SO laboratorio; proibido em hosted
# SPEC-300: alma dos companheiros (off|shadow|on; default on) e interruptor de loja do romance.
# RPG_COMPANION_SOUL=on
# RPG_COMPANION_ROMANCE=on   # off: estagio nunca avanca e a intencao romantica recebe recusa gentil

# SPEC-304: NPCs fora de cena (agenda, troca de lado, perigo e morte TELEGRAFADOS). off|shadow|on;
# exige RPG_WORLD_ENGINE=on (senao fica off). Default off (shadow no staging ate o smoke real).
# RPG_NPC_WORLD=off

# SPEC-310: o NPC sabe de si (<SOBRE_VOCE>/<MOTIVACOES_INTERNAS>/<O_QUE_VOCE_SABE>). on|off; default on.
# RPG_NPC_SELF=on
