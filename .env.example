# LLM Provider: gemini | ollama | openai | openai_compat (default: gemini)
LLM_PROVIDER=gemini

# --- Gemini (Google AI) ---
# Gerar em: https://aistudio.google.com/app/apikey
# Sem a chave o jogo roda em modo simulado (MockLLM) — jogável, sem IA real.
GOOGLE_API_KEY=

# --- Ollama (LLM local via Ollama) ---
# Requer: uv sync --extra ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_FAST=llama3.2      # ou qwen2.5, mistral, etc.
# OLLAMA_MODEL_SMART=llama3.1     # ou qwen2.5:72b

# --- OpenAI ---
# Requer: uv sync --extra openai
# OPENAI_API_KEY=
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_SMART=gpt-4o

# --- OpenAI-compatível (Qwen via Dashscope, LM Studio, etc.) ---
# LLM_PROVIDER=openai_compat
# OPENAI_API_KEY=<sua chave>
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL_FAST=qwen-plus
# OPENAI_MODEL_SMART=qwen-max

# --- Fase 10: hardening ---
# CORS da API (CSV). Default: localhost:8000 e :5173. "*" só se souber o risco.
# RPG_CORS_ORIGINS=http://localhost:8000,http://localhost:5173
# Rate limit de /game/action e /game/new (req/min por IP). 0 desliga.
# RPG_RATE_LIMIT=30
