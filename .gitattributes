# Default: let Git detect text vs binary and store/check out text as LF.
# (Workspace improvement #7: removes the "LF will be replaced by CRLF" noise
# and the hand-written \r\n handling in scripts. Windows tools handle LF.)
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Exact-byte eval locks and Project Index freshness must survive Git checkout
# on Windows and Linux. Keep hashes strict; make measured text bytes portable.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
Procfile text eol=lf

# Binary art is outside text conversion.
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
*.sha256 text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.mp3 binary
*.mp4 binary
*.pdf binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
